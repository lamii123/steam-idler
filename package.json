{
  "name": "steam-idler",
  "version": "1.1.0",
  "private": true,
  "description": "Self-hosted Steam idle panel. Connect with QR or password login and keep playtime ticking.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "node scripts/check.js"
  },
  "keywords": [
    "steam",
    "steam-idler",
    "self-hosted",
    "express",
    "steam-user"
  ],
  "author": "steam-idler contributors",
  "license": "ISC",
  "overrides": {
    "adm-zip": "^0.6.1",
    "protobufjs": "^7.6.5"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "qrcode": "^1.5.4",
    "steam-session": "^1.9.4",
    "steam-user": "^5.3.0"
  }
}
