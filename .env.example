# Copy this file to .env and fill in real values before running the app.
# Never commit your real .env file.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Cookie security. Defaults to true when NODE_ENV=production.
# Set to false only when serving the panel over plain HTTP on a trusted LAN
# (for example http://192.168.1.10:8080). Keep true for HTTPS.
COOKIE_SECURE=

# Upgrade insecure subresource requests to HTTPS through CSP. Defaults to true
# when NODE_ENV=production and COOKIE_SECURE is true. Set false for LAN HTTP.
UPGRADE_INSECURE_REQUESTS=

# 32 random bytes, hex-encoded (64 hex chars). Used to encrypt Steam refresh
# tokens at rest with AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENC_KEY=

# Any long random string. Used to sign the session-id cookie so it can't be
# forged or tampered with client-side. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Steam Web API key. Required for the dashboard: profile data and the game
# library are fetched with this key. Get one at:
#   https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Number of reverse-proxy hops in front of the app (Express "trust proxy").
# 0 when exposing the Node port directly; 1 when running behind a single
# nginx/Caddy/Cloudflare hop. A wrong value here lets X-Forwarded-For spoofing
# bypass IP rate limits. Whether cookies get the __Host- prefix follows
# COOKIE_SECURE, not NODE_ENV.
TRUST_PROXY=0

# Where sessions.json and machineTokens.json are stored.
DATA_DIR=./data

# Timeout for Steam Web API requests, in milliseconds.
STEAM_API_TIMEOUT_MS=10000

# error | warn | info | debug
LOG_LEVEL=debug
